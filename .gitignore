# Exclude all hidden files
.*

# Except those related to git
!.git*

# publi.sh
!.publi.sh

# python cache
__pycache__
*.pyc

# virtual environments
venv/
env/

# log dir
log/*

# chache files
cache/*

# settings file
settings.ini

# script-generated output (Excel/CSV reports, per-vCenter logs)
*.xlsx
DepartmentGroupCounts.csv

# never commit key material
*.pem
*.key
*.pfx